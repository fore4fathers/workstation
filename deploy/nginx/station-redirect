# Redirect the previous workstation hostname to engageai.digital.
server {
    listen 80;
    listen [::]:80;
    server_name station.kmlaw.it.com;
    return 301 https://engageai.digital$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name station.kmlaw.it.com;

    ssl_certificate /etc/letsencrypt/live/station.kmlaw.it.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/station.kmlaw.it.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://engageai.digital$request_uri;
}
